import random
item = ["rock", "paper", "scissors"]
scores = 0
attempt = 0

print("==========================================")
print("⚠️ PERTANDINGAN DIMULAI ⚠️")
print("Kamu hanya punya 5 KESEMPATAN untuk bertahan hidup.")
print("Setiap keputusan menentukan nasibmu...")
print("==========================================\n")
while attempt < 10:
    computer = random.choice(item)
    user = input("enter your choice: ").lower().strip()
    if user not in item:
        print("invalid choice! enter rock, paper, scissors")
        continue
    elif ((user == "scissors" and computer == "paper") or \
         (user == "paper" and computer == "rock") or \
         (user == "rock" and computer == "scissors")):
            print(f"you win! computer choose {computer}")
            scores += 1
    elif user == computer:
        print("it's a tie")
    else:
        print(f"you lose! computer choose {computer}")
    attempt += 1
print(f"time is over! your score is {scores}")
if scores <= 5:
    print("WAKTU HABIS! Kamu gagal mengalahkan sistem...")
elif scores >= 6:
    print("SELAMAT! Kamu berhasil lolos dari 5 ronde maut!")



